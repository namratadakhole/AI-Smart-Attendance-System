# MongoDB Connection String (Atlas URI in production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_attendance?retryWrites=true&w=majority

# Secret key for JWT auth token generation and signing
JWT_SECRET=your-super-secret-production-jwt-key-change-this

# Restrict allowed frontend host domain origin for security
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Server Port (Render sets this dynamically via env)
PORT=5000
